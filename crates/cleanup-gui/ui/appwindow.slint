import { ScrollView, ComboBox } from "std-widgets.slint";

// A quiet, document-first interface: warm neutrals, crisp borders and one restrained
// forest-green accent. No gradients, glow effects or decorative dashboard chrome.

component LevelOption inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> selected;
    callback clicked;

    height: 64px;
    border-radius: 10px;
    border-width: 1px;
    border-color: selected ? #9eb3a7 : (touch.has-hover ? #d2d9d2 : transparent);
    background: selected ? #eaf0eb : (touch.has-hover ? #f7f8f4 : transparent);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    Rectangle {
        x: 14px;
        y: 15px;
        width: 17px;
        height: 17px;
        border-radius: 9px;
        border-width: 1.5px;
        border-color: selected ? #265c4a : #aab2ab;
        background: #ffffff;
        Rectangle {
            x: 4px;
            y: 4px;
            width: 9px;
            height: 9px;
            border-radius: 5px;
            background: #265c4a;
            visible: selected;
        }
    }

    VerticalLayout {
        x: 43px;
        y: 11px;
        width: parent.width - 56px;
        spacing: 3px;
        Text {
            text: root.title;
            color: #202722;
            font-size: 13px;
            font-weight: 600;
        }
        Text {
            text: root.description;
            color: #717a73;
            font-size: 11px;
            wrap: word-wrap;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Metric inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <brush> value-color;

    height: 64px;
    border-radius: 10px;
    background: #f6f7f3;
    HorizontalLayout {
        padding-left: 15px;
        padding-right: 15px;
        spacing: 12px;
        Text {
            text: root.value;
            color: root.value-color;
            font-size: 25px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: #68716b;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 176px;
    height: 44px;
    border-radius: 9px;
    background: !enabled ? #cbd2cc : (touch.has-hover ? #1d493b : #265c4a);
    animate background { duration: 100ms; }
    Text {
        text: root.label;
        color: #ffffff;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "llm-cleanup";
    default-font-family: "Inter";
    default-font-size: 14px;
    preferred-width: 920px;
    preferred-height: 720px;
    min-width: 820px;
    min-height: 680px;
    background: #f3f4ef;

    in property <string> file-name;
    in property <bool> has-file;
    in property <int> level: 1;
    in-out property <int> target;
    in property <bool> did-run;
    in property <bool> has-error;
    in property <int> cleaned-count;
    in property <int> flagged-count;
    in property <string> preview-text;
    in property <string> status: "Your original file stays untouched.";
    in property <bool> can-save;

    callback browse();
    callback set-level(int);
    callback set-target(int);
    callback clean-and-save();

    VerticalLayout {
        padding: 28px;
        spacing: 22px;

        // Product header: identity on the left, one meaningful trust cue on the right.
        HorizontalLayout {
            height: 42px;
            spacing: 12px;
            Image {
                source: @image-url("icons/logo-mark.svg");
                width: 38px;
                height: 38px;
                vertical-alignment: center;
            }
            VerticalLayout {
                spacing: 1px;
                alignment: center;
                Text {
                    text: "llm-cleanup";
                    color: #1e2521;
                    font-size: 20px;
                    font-weight: 700;
                }
                Text {
                    text: "Document hygiene, without the guesswork";
                    color: #788079;
                    font-size: 11px;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Image {
                source: @image-url("icons/shield-check.svg");
                width: 18px;
                height: 18px;
                vertical-alignment: center;
            }
            Text {
                text: "Offline by design";
                color: #566159;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        Rectangle { height: 1px; background: #dde1da; }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 26px;

            // Configuration column. Section labels and explanatory copy make the three
            // cleanup modes understandable without opening the documentation.
            VerticalLayout {
                width: 294px;
                spacing: 20px;
                alignment: start;

                VerticalLayout {
                    spacing: 9px;
                    Text {
                        text: "Document";
                        color: #3d4740;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    Rectangle {
                        height: 88px;
                        border-radius: 11px;
                        border-width: 1px;
                        border-color: file-touch.has-hover ? #91a89a : #d9dfd8;
                        background: file-touch.has-hover ? #fbfcfa : #ffffff;
                        animate border-color { duration: 120ms; }
                        animate background { duration: 120ms; }
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                width: 40px;
                                alignment: center;
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 9px;
                                    background: #eaf0eb;
                                    Image {
                                        source: @image-url("icons/upload.svg");
                                        width: 21px;
                                        height: 21px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 5px;
                                Text {
                                    text: root.has-file ? root.file-name : "Choose a document";
                                    color: #252c27;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.has-file ? "Click to choose another file" : "Markdown, text, or Word";
                                    color: #858d86;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: "Browse";
                                color: #265c4a;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        file-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.browse(); }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 9px;
                    Text {
                        text: "Cleanup strength";
                        color: #3d4740;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    LevelOption {
                        title: "Light";
                        description: "Invisible characters and hidden residue";
                        selected: root.level == 0;
                        clicked => { root.set-level(0); }
                    }
                    LevelOption {
                        title: "Standard";
                        description: "Light cleanup, plus safe typography";
                        selected: root.level == 1;
                        clicked => { root.set-level(1); }
                    }
                    LevelOption {
                        title: "Aggressive";
                        description: "Full cleanup and document metadata scrub";
                        selected: root.level == 2;
                        clicked => { root.set-level(2); }
                    }
                }

                VerticalLayout {
                    spacing: 9px;
                    Text {
                        text: "Output format";
                        color: #3d4740;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    ComboBox {
                        width: 100%;
                        height: 40px;
                        model: ["Same as input", "Markdown (.md)", "Text (.txt)", "Word (.docx)", "PDF (.pdf)"];
                        current-index <=> root.target;
                        selected(value) => { root.set-target(self.current-index); }
                    }
                }
            }

            // Report surface. Metrics stay stable between states; only their values change.
            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                border-radius: 13px;
                border-width: 1px;
                border-color: #dde1da;
                background: #ffffff;
                clip: true;

                VerticalLayout {
                    padding: 23px;
                    spacing: 17px;

                    VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: root.has-error ? "Unable to process document" : (root.did-run ? "Cleanup report" : "Ready when you are");
                            color: #202722;
                            font-size: 19px;
                            font-weight: 700;
                        }
                        Text {
                            text: root.has-error ? "The original file has not been changed." : (root.did-run ? "Review the changes before saving your copy." : "Choose a file to see a precise, itemized report.");
                            color: #788079;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 11px;
                        Metric {
                            horizontal-stretch: 1;
                            value: root.did-run && !root.has-error ? "\{root.cleaned-count}" : "—";
                            label: "changes made";
                            value-color: #2f6b50;
                        }
                        Metric {
                            horizontal-stretch: 1;
                            value: root.did-run && !root.has-error ? "\{root.flagged-count}" : "—";
                            label: "left for review";
                            value-color: #94652a;
                        }
                    }

                    Rectangle { height: 1px; background: #e7eae4; }

                    Rectangle {
                        vertical-stretch: 1;

                        VerticalLayout {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            visible: root.preview-text == "";
                            alignment: center;
                            spacing: 10px;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 48px;
                                    height: 48px;
                                    border-radius: 12px;
                                    background: #f0f3ed;
                                    Image {
                                        source: @image-url("icons/upload.svg");
                                        width: 23px;
                                        height: 23px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                            Text {
                                text: "Nothing to review yet";
                                color: #39423b;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Your document is analyzed locally. Formatting and structure stay intact.";
                                color: #8a918b;
                                font-size: 12px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        results-scroll := ScrollView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            visible: root.preview-text != "";
                            VerticalLayout {
                                width: results-scroll.visible-width;
                                padding-right: 5px;
                                alignment: start;
                                Text {
                                    text: root.preview-text;
                                    color: root.has-error ? #9b493f : #465049;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 44px;
            spacing: 14px;
            Image {
                source: @image-url("icons/shield-check.svg");
                width: 16px;
                height: 16px;
                vertical-alignment: center;
            }
            Text {
                text: root.status;
                color: root.has-error ? #9b493f : #717a73;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            PrimaryButton {
                label: "Save cleaned file";
                enabled: root.can-save;
                clicked => { root.clean-and-save(); }
            }
        }
    }
}
