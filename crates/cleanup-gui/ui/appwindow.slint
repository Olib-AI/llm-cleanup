import { ScrollView, ComboBox } from "std-widgets.slint";

// A quiet, document-first interface: warm neutrals, crisp borders and one restrained
// forest-green accent. Explicit panel bounds keep every control inside the window.

component LevelOption inherits Rectangle {
    in property <string> title;
    in property <string> description;
    in property <bool> selected;
    callback clicked;

    // `content` already carries the 12px padding, so size the card to its full height.
    height: max(68px, content.preferred-height);
    border-radius: 10px;
    border-width: 1px;
    border-color: selected ? #91aa9b : (touch.has-hover ? #bdc9c0 : #dde2db);
    background: selected ? #eaf0eb : (touch.has-hover ? #f7f9f5 : #ffffff);
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }

    // One padded column. The radio lives in the title row so the ring is always
    // centered on the title's line box, and the description indents beneath it.
    content := VerticalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 4px;

        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 18px;
                height: 18px;
                // Fixed-size children are top-aligned inside a layout, so center the
                // ring explicitly on this row (the same idiom Slint's CheckBox uses).
                y: (parent.height - self.height) / 2;
                border-radius: 9px;
                border-width: 1.5px;
                border-color: root.selected ? #265c4a : #aab2ab;
                background: #ffffff;
                Rectangle {
                    x: 5px;
                    y: 5px;
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: #265c4a;
                    visible: root.selected;
                }
            }
            Text {
                text: root.title;
                color: #202722;
                font-size: 13px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 12px;
            // Spacer matching the radio column keeps the description under the title.
            Rectangle {
                width: 18px;
                height: 1px;
            }
            Text {
                text: root.description;
                color: #717a73;
                font-size: 11px;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component Metric inherits Rectangle {
    in property <string> value;
    in property <string> label;
    in property <brush> value-color;

    height: 72px;
    border-radius: 10px;
    border-width: 1px;
    border-color: #e5e9e2;
    background: #f6f7f3;
    VerticalLayout {
        padding: 12px;
        spacing: 3px;
        alignment: center;
        Text {
            text: root.value;
            color: root.value-color;
            font-size: 23px;
            font-weight: 700;
            overflow: elide;
        }
        Text {
            text: root.label;
            color: #68716b;
            font-size: 11px;
            overflow: elide;
        }
    }
}

component PrimaryButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked;

    width: 184px;
    height: 46px;
    border-radius: 9px;
    background: !enabled ? #dce1dc : (touch.pressed ? #173d31 : (touch.has-hover ? #1d493b : #265c4a));
    animate background { duration: 100ms; }
    Text {
        text: root.label;
        color: enabled ? #ffffff : #7c867e;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component AppWindow inherits Window {
    title: "llm-cleanup";
    icon: @image-url("icons/app-icon.svg");
    default-font-family: "Inter";
    default-font-size: 14px;
    preferred-width: 960px;
    preferred-height: 740px;
    min-width: 820px;
    min-height: 700px;
    background: #f3f4ef;

    in property <string> file-name;
    in property <bool> has-file;
    in property <int> level: 1;
    in-out property <int> target;
    in property <bool> did-run;
    in property <bool> has-error;
    in property <int> cleaned-count;
    in property <int> flagged-count;
    in property <string> preview-text;
    in property <string> status: "Your original file stays untouched.";
    in property <bool> can-save;

    callback browse();
    callback set-level(int);
    callback set-target(int);
    callback clean-and-save();

    VerticalLayout {
        width: 100%;
        height: 100%;
        padding: 26px;
        spacing: 20px;

        // Product header: identity on the left, one meaningful trust cue on the right.
        HorizontalLayout {
            height: 44px;
            spacing: 12px;
            Image {
                source: @image-url("icons/logo-mark.svg");
                width: 40px;
                height: 40px;
                // A layout top-aligns fixed-size elements; center explicitly on the row.
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                Text {
                    text: "llm-cleanup";
                    color: #1e2521;
                    font-size: 20px;
                    font-weight: 700;
                    overflow: elide;
                }
                Text {
                    text: "Document hygiene, without the guesswork";
                    color: #788079;
                    font-size: 11px;
                    overflow: elide;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Image {
                source: @image-url("icons/shield-check.svg");
                width: 18px;
                height: 18px;
                // A layout top-aligns fixed-size elements; center explicitly on the row.
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: "Offline by design";
                color: #566159;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Rectangle { height: 1px; background: #dde1da; }

        // Bind both columns to the available rectangle instead of letting their
        // intrinsic content widths push the report beyond the window edge.
        Rectangle {
            vertical-stretch: 1;
            min-height: 462px;

            // Configuration column.
            VerticalLayout {
                x: 0;
                y: 0;
                width: 300px;
                height: parent.height;
                spacing: 18px;
                alignment: start;

                VerticalLayout {
                    spacing: 9px;
                    Text {
                        text: "Document";
                        color: #3d4740;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    Rectangle {
                        height: 88px;
                        border-radius: 11px;
                        border-width: 1px;
                        border-color: file-touch.has-hover ? #91a89a : #d9dfd8;
                        background: file-touch.has-hover ? #fbfcfa : #ffffff;
                        animate border-color { duration: 120ms; }
                        animate background { duration: 120ms; }
                        HorizontalLayout {
                            padding: 14px;
                            spacing: 12px;
                            VerticalLayout {
                                width: 40px;
                                alignment: center;
                                Rectangle {
                                    width: 40px;
                                    height: 40px;
                                    border-radius: 9px;
                                    background: #eaf0eb;
                                    Image {
                                        source: @image-url("icons/upload.svg");
                                        width: 21px;
                                        height: 21px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 5px;
                                Text {
                                    text: root.has-file ? root.file-name : "Choose a document";
                                    color: #252c27;
                                    font-size: 13px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: root.has-file ? "Click to choose another file" : "Markdown, text, or Word";
                                    color: #858d86;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                            Text {
                                text: "Browse";
                                color: #265c4a;
                                font-size: 12px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                        }
                        file-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.browse(); }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Cleanup strength";
                        color: #3d4740;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    LevelOption {
                        title: "Light";
                        description: "Invisible characters and hidden residue";
                        selected: root.level == 0;
                        clicked => { root.set-level(0); }
                    }
                    LevelOption {
                        title: "Standard";
                        description: "Light cleanup, plus safe typography";
                        selected: root.level == 1;
                        clicked => { root.set-level(1); }
                    }
                    LevelOption {
                        title: "Aggressive";
                        description: "Full cleanup and document metadata scrub";
                        selected: root.level == 2;
                        clicked => { root.set-level(2); }
                    }
                }

                VerticalLayout {
                    spacing: 9px;
                    Text {
                        text: "Output format";
                        color: #3d4740;
                        font-size: 12px;
                        font-weight: 600;
                    }
                    ComboBox {
                        width: 100%;
                        height: 42px;
                        model: ["Same as input", "Markdown (.md)", "Text (.txt)", "Word (.docx)", "PDF (.pdf)"];
                        current-index <=> root.target;
                        selected(value) => { root.set-target(self.current-index); }
                    }
                }
            }

            // Report surface. Its right edge always tracks the main content's right edge.
            Rectangle {
                x: 322px;
                y: 0;
                width: parent.width - 322px;
                height: parent.height;
                border-radius: 13px;
                border-width: 1px;
                border-color: #dde1da;
                background: #ffffff;
                clip: true;

                VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    padding: 22px;
                    spacing: 16px;

                    VerticalLayout {
                        spacing: 5px;
                        Text {
                            text: root.has-error ? "Unable to process document" : (root.did-run ? "Cleanup report" : "Ready when you are");
                            color: #202722;
                            font-size: 19px;
                            font-weight: 700;
                            overflow: elide;
                        }
                        Text {
                            text: root.has-error ? "The original file has not been changed." : (root.did-run ? "Review the changes before saving your copy." : "Choose a file to see a precise, itemized report.");
                            color: #788079;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }

                    HorizontalLayout {
                        spacing: 11px;
                        Metric {
                            horizontal-stretch: 1;
                            value: root.did-run && !root.has-error ? "\{root.cleaned-count}" : "—";
                            label: "changes made";
                            value-color: #2f6b50;
                        }
                        Metric {
                            horizontal-stretch: 1;
                            value: root.did-run && !root.has-error ? "\{root.flagged-count}" : "—";
                            label: "left for review";
                            value-color: #94652a;
                        }
                    }

                    Rectangle { height: 1px; background: #e7eae4; }

                    Rectangle {
                        vertical-stretch: 1;
                        min-height: 0px;
                        clip: true;

                        VerticalLayout {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            visible: root.preview-text == "";
                            alignment: center;
                            spacing: 10px;
                            padding-left: 12px;
                            padding-right: 12px;
                            HorizontalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 48px;
                                    height: 48px;
                                    border-radius: 12px;
                                    background: #f0f3ed;
                                    Image {
                                        source: @image-url("icons/upload.svg");
                                        width: 23px;
                                        height: 23px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                            Text {
                                text: "Nothing to review yet";
                                color: #39423b;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            Text {
                                text: "Your document is analyzed locally. Formatting and structure stay intact.";
                                color: #8a918b;
                                font-size: 12px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        results-scroll := ScrollView {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            visible: root.preview-text != "";
                            VerticalLayout {
                                width: results-scroll.visible-width;
                                padding-right: 8px;
                                alignment: start;
                                Text {
                                    text: root.preview-text;
                                    color: root.has-error ? #9b493f : #465049;
                                    font-size: 13px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }

        HorizontalLayout {
            height: 46px;
            spacing: 14px;
            Image {
                source: @image-url("icons/shield-check.svg");
                width: 16px;
                height: 16px;
                // A layout top-aligns fixed-size elements; center explicitly on the row.
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.status;
                color: root.has-error ? #9b493f : #717a73;
                font-size: 11px;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            PrimaryButton {
                label: "Save cleaned file";
                enabled: root.can-save;
                clicked => { root.clean-and-save(); }
            }
        }
    }
}
